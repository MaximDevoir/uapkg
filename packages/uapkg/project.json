{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "uapkg",
  "sourceRoot": "packages/uapkg/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run build -- --production"
      },
      "configurations": {
        "development": {
          "command": "pnpm run build -- --development"
        },
        "production": {
          "command": "pnpm run build -- --production"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run test"
      }
    }
  },
  "tags": ["type:lib", "scope:orchestration"]
}
