{
  "name": "@uapkg/cli",
  "version": "1.2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "uapkg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@amplication/csharp-ast": "0.1.0",
    "@napi-rs/keyring": "1.3.0",
    "@types/yargs": "17.0.35",
    "@uapkg/common": "workspace:^",
    "@uapkg/common-schema": "workspace:^",
    "@uapkg/config": "workspace:^",
    "@uapkg/diagnostics": "workspace:^",
    "@uapkg/diagnostics-format": "workspace:^",
    "@uapkg/installer": "workspace:^",
    "@uapkg/log": "workspace:^",
    "@uapkg/pack": "workspace:^",
    "@uapkg/package-claims": "workspace:^",
    "@uapkg/package-manifest": "workspace:^",
    "@uapkg/package-manifest-schema": "workspace:^",
    "@uapkg/registry-core": "workspace:^",
    "esbuild": "0.28.0",
    "ink": "6.8.0",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "is-ci": "4.1.0",
    "oauth4webapi": "3.8.6",
    "open": "11.0.0",
    "react": "19.2.4",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "tar": "7.5.13",
    "@types/react": "19.2.14"
  },
  "scripts": {
    "uapkg": "pnpm nx run uapkg:build:development && node dist/cli.js",
    "build": "tsx build/runCliBuild.ts",
    "prepack": "pnpm run build -- --production && pnpm run verify:production-build",
    "build:watch": "pnpm nx watch --projects uapkg --includeDependentProjects --initialRun -- pnpm nx run uapkg:build:development",
    "verify:production-build": "tsx build/verifyProductionBuild.ts",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximDevoir/uapkg.git",
    "directory": "packages/uapkg"
  }
}
