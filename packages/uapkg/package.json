{
  "name": "@uapkg/cli",
  "version": "1.3.1",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximDevoir/uapkg.git",
    "directory": "packages/uapkg"
  },
  "bin": {
    "uapkg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "uapkg": "vp run -w --cache cli:build -- --development && vp exec node dist/cli.js",
    "build": "node build/runCliBuild.ts",
    "prepack": "vp run -w --cache cli:build -- --production && vp run verify:production-build",
    "build:watch": "vp pack --watch --on-success \"vp exec node build/finalizeCliBuild.ts --development\"",
    "verify:production-build": "vp exec node build/verifyProductionBuild.ts"
  },
  "dependencies": {
    "@amplication/csharp-ast": "0.1.0",
    "@napi-rs/keyring": "1.3.0",
    "@types/yargs": "17.0.35",
    "@uapkg/common": "workspace:^",
    "@uapkg/common-schema": "workspace:^",
    "@uapkg/config": "workspace:^",
    "@uapkg/diagnostics": "workspace:^",
    "@uapkg/diagnostics-format": "workspace:^",
    "@uapkg/installer": "workspace:^",
    "@uapkg/log": "workspace:^",
    "@uapkg/pack": "workspace:^",
    "@uapkg/package-claims": "workspace:^",
    "@uapkg/package-manifest": "workspace:^",
    "@uapkg/package-manifest-schema": "workspace:^",
    "@uapkg/registry-core": "workspace:^",
    "@uapkg/registry-schema": "workspace:^",
    "esbuild": "0.28.0",
    "ink": "6.8.0",
    "ink-select-input": "6.2.0",
    "ink-text-input": "6.0.0",
    "is-ci": "4.1.0",
    "oauth4webapi": "3.8.6",
    "open": "11.0.0",
    "react": "19.2.4",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "tar": "7.5.13"
  }
}
