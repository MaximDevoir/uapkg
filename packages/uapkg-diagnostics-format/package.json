      "types": "./dist/ink/index.d.ts",
      "default": "./dist/ink/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "build:watch": "vp pack --watch"
  },
  "dependencies": {
    "@uapkg/diagnostics": "workspace:^",
    "ink": "6.8.0",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14"
  }
}
