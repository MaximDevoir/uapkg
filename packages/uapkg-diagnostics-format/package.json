{
  "name": "@uapkg/diagnostics-format",
  "version": "1.3.1",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximDevoir/uapkg.git",
    "directory": "packages/uapkg-diagnostics-format"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
