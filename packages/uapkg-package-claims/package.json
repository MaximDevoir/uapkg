{
  "name": "@uapkg/package-claims",
  "version": "1.3.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@uapkg/common-schema": "workspace:^",
    "@uapkg/diagnostics": "workspace:^",
    "@uapkg/package-manifest-schema": "workspace:^",
    "@uapkg/registry-schema": "workspace:^",
    "tar": "7.5.13"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "zod": "4.3.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaximDevoir/uapkg.git",
    "directory": "packages/uapkg-package-claims"
  }
}
