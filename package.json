{
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "change": "changeset",
    "release": "changeset publish",
    "prepare": "vp config --hooks-dir .vite-hooks --no-agent",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "build": "vp exec node tools/dev-build/runDevBuild.ts build",
    "build:link": "vp exec node tools/dev-build/runDevBuild.ts link",
    "build:watch": "vp exec node tools/dev-build/runDevBuild.ts watch",
    "build:unlink": "vp exec node tools/dev-build/runDevBuild.ts unlink",
    "build:status": "vp exec node tools/dev-build/runDevBuild.ts status",
    "build:clean": "vp exec node tools/dev-build/runDevBuild.ts clean",
    "clean:all": "vp exec node tools/dev-build/runDevBuild.ts cleanAll",
    "consumer:bundle": "vp exec node tools/consumer-bundle/runConsumerBundle.ts",
    "deps:consumer-bundle": "vp run consumer:bundle",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "verify": "vp check && vp test run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@types/node": "26.2.0",
    "@types/semver": "7.7.0",
    "@vitest/coverage-v8": "catalog:",
    "semver": "7.7.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "dotenv": "17.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
