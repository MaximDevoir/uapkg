{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@uapkg/config": ["./packages/uapkg-config/src/index.ts"],
      "@uapkg/log": ["./packages/uapkg-log/src/index.ts"],
      "@uapkg/pack": ["./packages/uapkg-pack/src/index.ts"],
      "@uapkg/diagnostics": ["./packages/uapkg-diagnostics/src/index.ts"],
      "@uapkg/diagnostics-format": ["./packages/uapkg-diagnostics-format/src/index.ts"],
      "@uapkg/diagnostics-format/ink": ["./packages/uapkg-diagnostics-format/src/ink/index.ts"],
      "@uapkg/common": ["./packages/uapkg-common/src/index.ts"],
      "@uapkg/common-schema": ["./packages/uapkg-common-schema/src/index.ts"],
      "@uapkg/registry-schema": ["./packages/uapkg-registry-schema/src/index.ts"],
      "@uapkg/registry-core": ["./packages/uapkg-registry-core/src/index.ts"],
      "@uapkg/registry-tools": ["./packages/uapkg-registry-tools/src/index.ts"],
      "@uapkg/package-manifest-schema": ["./packages/uapkg-package-manifest-schema/src/index.ts"],
      "@uapkg/package-manifest": ["./packages/uapkg-package-manifest/src/index.ts"],
      "@uapkg/package-claims": ["./packages/uapkg-package-claims/src/index.ts"],
      "@uapkg/package-claims/schema": ["./packages/uapkg-package-claims/src/schema/index.ts"],
      "@uapkg/installer": ["./packages/uapkg-installer/src/index.ts"],
      "@uapkg/cli": ["./packages/uapkg/src/index.ts"]
    }
  }
}
