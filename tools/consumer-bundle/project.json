{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "consumer-bundle-tools",
  "sourceRoot": "tools/consumer-bundle",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec biome lint tools/consumer-bundle"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec tsc -p tools/consumer-bundle/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec vitest run --config tools/consumer-bundle/vitest.config.ts"
      }
    }
  },
  "tags": ["type:tooling", "scope:development"]
}
